# Copy this file to .env and fill it in. .env is gitignored: never commit it.

# --- PostgreSQL (runs in Docker: `docker compose up -d db`) -----------------------------
# docker-compose.yml creates the database with these values the FIRST time the volume is
# created, and the app connects with the same ones. Change the password before first start.
# Host port 5433 (not 5432), so it doesn't clash with another local Postgres.
PGHOST=localhost
PGPORT=5433
PGDATABASE=fixit
PGUSER=fixit
PGPASSWORD=replace-with-a-long-random-password

# --- API ---------------------------------------------------------------------------------
# HTTP port for the API. The frontend dev server proxies /api to this port.
PORT=3000

# Secret used to sign sign-in tokens. At least 32 random characters, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# How long a sign-in lasts (jsonwebtoken format: 7d, 12h, ...)
JWT_TTL=7d

# Where uploaded issue photos are stored (created automatically).
UPLOAD_DIR=./data/uploads

# --- OpenStreetMap (Nominatim) geocoding ---------------------------------------------------
# No API key, but the usage policy requires a descriptive User-Agent identifying the app.
# Leave empty to disable geocoding (properties then have no map pin).
NOMINATIM_USER_AGENT=fixit-course-project/1.0
# Language for place names (without it Nominatim answers in the local language: "España").
GEOCODE_LANGUAGE=en
